  author  = {Fiesler, Casey and Aspray, William and Barker, Lecia and Brubaker, Jed and Devendorf, Laura and Keegan, Brian and Palen, Leysia and Paul, Michael and Szafir, Danielle and Roque, Ricarose and Robinson, Rick and Voida, Amy and Voida, Stephen},
